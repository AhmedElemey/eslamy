<?xml version="1.0" encoding="utf-8"?>
<!-- Dedicated layout for the Prayer content kind only (see
     EslamyWidgetProvider.kt#buildViews) — the plain 3-line layout doesn't
     have room for a full daily schedule, so this kind gets its own
     RemoteViews swapped in instead of reusing eslamy_widget_layout. Same
     root id (eslamy_widget_root) as that layout so the click intent wiring
     stays identical regardless of which one is active.

     Light card style (reference design), not the teal gradient the other
     3-line kinds use — a light parchment card with a slightly darker inset
     band behind the schedule row, and a dark pill on the current prayer's
     time instead of gold-on-teal. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/eslamy_widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/eslamy_widget_prayer_card_background"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <ImageView
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:src="@mipmap/ic_launcher"
            android:contentDescription="@null" />

        <TextView
            android:id="@+id/eslamy_prayer_kicker"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:textColor="#6B736F"
            android:textSize="11sp"
            android:textStyle="bold"
            android:singleLine="true"
            android:ellipsize="end"
            tools:text="NEXT PRAYER" />

        <!-- Today's real Gregorian date (e.g. "Sat 22 Aug") — computed
             fresh on every push, see WidgetContentBuilder.prayerDateCompact,
             never a static/placeholder string. Short by design so this row
             stays well under a narrow widget's width budget. -->
        <TextView
            android:id="@+id/eslamy_prayer_date"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:textColor="#6B736F"
            android:textSize="11sp"
            android:singleLine="true"
            android:ellipsize="end"
            android:maxWidth="90dp"
            android:textDirection="locale"
            tools:text="Sat 22 Aug" />
    </LinearLayout>

    <TextView
        android:id="@+id/eslamy_prayer_next_line"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:textColor="#1C2A26"
        android:textSize="18sp"
        android:textStyle="bold"
        android:textDirection="locale"
        android:singleLine="true"
        android:ellipsize="end"
        tools:text="Maghrib · 7:31 PM" />

    <!-- Inset band, slightly darker than the card, holding the 5-column
         schedule row — the two-tone look from the reference design. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:orientation="horizontal"
        android:background="@drawable/eslamy_widget_prayer_schedule_band"
        android:paddingHorizontal="8dp"
        android:paddingVertical="10dp">

        <!-- 5 fixed columns: Fajr, Dhuhr, Asr, Maghrib, Isha (Sunrise
             excluded — see WidgetContentBuilder.prayerSchedule). Fixed
             count/order lets Kotlin populate by index instead of needing a
             RemoteViewsService-backed collection just for 5 static cells. -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center_horizontal">
            <TextView
                android:id="@+id/eslamy_prayer_name_0"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:textColor="#6B736F"
                android:textSize="10sp"
                android:singleLine="true"
                android:ellipsize="end"
                tools:text="Fajr" />
            <TextView
                android:id="@+id/eslamy_prayer_time_0"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:paddingHorizontal="6dp"
                android:paddingVertical="2dp"
                android:textColor="#1C2A26"
                android:textSize="12sp"
                android:textStyle="bold"
                android:singleLine="true"
                android:ellipsize="end"
                tools:text="4:54" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center_horizontal">
            <TextView
                android:id="@+id/eslamy_prayer_name_1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:textColor="#6B736F"
                android:textSize="10sp"
                android:singleLine="true"
                android:ellipsize="end"
                tools:text="Dhuhr" />
            <TextView
                android:id="@+id/eslamy_prayer_time_1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:paddingHorizontal="6dp"
                android:paddingVertical="2dp"
                android:textColor="#1C2A26"
                android:textSize="12sp"
                android:textStyle="bold"
                android:singleLine="true"
                android:ellipsize="end"
                tools:text="12:59" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center_horizontal">
            <TextView
                android:id="@+id/eslamy_prayer_name_2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:textColor="#6B736F"
                android:textSize="10sp"
                android:singleLine="true"
                android:ellipsize="end"
                tools:text="Asr" />
            <TextView
                android:id="@+id/eslamy_prayer_time_2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:paddingHorizontal="6dp"
                android:paddingVertical="2dp"
                android:textColor="#1C2A26"
                android:textSize="12sp"
                android:textStyle="bold"
                android:singleLine="true"
                android:ellipsize="end"
                tools:text="4:36" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center_horizontal">
            <TextView
                android:id="@+id/eslamy_prayer_name_3"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:textColor="#6B736F"
                android:textSize="10sp"
                android:singleLine="true"
                android:ellipsize="end"
                tools:text="Maghrib" />
            <TextView
                android:id="@+id/eslamy_prayer_time_3"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:paddingHorizontal="6dp"
                android:paddingVertical="2dp"
                android:textColor="#1C2A26"
                android:textSize="12sp"
                android:textStyle="bold"
                android:singleLine="true"
                android:ellipsize="end"
                tools:text="7:31" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center_horizontal">
            <TextView
                android:id="@+id/eslamy_prayer_name_4"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:textColor="#6B736F"
                android:textSize="10sp"
                android:singleLine="true"
                android:ellipsize="end"
                tools:text="Isha" />
            <TextView
                android:id="@+id/eslamy_prayer_time_4"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:paddingHorizontal="6dp"
                android:paddingVertical="2dp"
                android:textColor="#1C2A26"
                android:textSize="12sp"
                android:textStyle="bold"
                android:singleLine="true"
                android:ellipsize="end"
                tools:text="8:53" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
